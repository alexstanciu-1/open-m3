<?php
declare(strict_types=1);

require_once "json_loader.hpp";
require_once "model_assembler.hpp";
require_once "model_validator.hpp";
require_once "orm/node_base.hpp";
require_once "orm/root.hpp";
require_once "orm/node.hpp";
require_once "orm/mat.hpp";
require_once "orm/materialization_probe.hpp";
require_once "orm/error.hpp";
require_once "orm/audit_entry.hpp";
require_once "orm/audit_result.hpp";
require_once "db/structure_builder.hpp";
require_once "db/database.hpp";
require_once "db/table.hpp";
require_once "db/column.hpp";
require_once "db/index.hpp";
require_once "db/reference.hpp";

namespace om3\base\app;

$model_path = "../samples/h2b/model/tfh/property.json";
$storage_path = "../samples/h2b/storage/tfh/property.json";

$m = \om3\base\load\json_loader::load_model($model_path);
$s = \om3\base\load\json_loader::load_storage($storage_path);

if ($m === null || $s === null) {
	echo "load_failed\n";
} else {
	\om3\base\load\json_loader::attach_storage($m, $s);

	$property_count = $m->property_count;
	$storage_property_count = $s->property_count;
	$first_property_name = "";
	if (isset($m->properties["id"])) {
		$first_property = $m->properties["id"];
		$first_property_name = $first_property->name;
	}
	$has_attached_storage = ($m->attached_storage !== null) ? "yes" : "no";
	$first_attached_storage = "no";
	if (isset($m->properties["id"]) && $m->properties["id"]->attached_storage !== null) {
		$first_attached_storage = "yes";
	}

	echo $m->name, "\n";
	echo $property_count, "\n";
	echo $storage_property_count, "\n";
	echo $first_property_name, "\n";
	echo $has_attached_storage, "\n";
	echo $s->table, "\n";
	echo $first_attached_storage, "\n";
}
