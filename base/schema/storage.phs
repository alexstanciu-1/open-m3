<?php
declare(strict_types=1);

namespace om3\base\schema;

/** @lib-export */
class storage
{
	public ?string $table = null;
	public ?string $engine = null;
	public ?string $database = null;
	public mixed $primary_key = null;
	public ?string $type_column = null;
	public mixed $indexes = null;
	public int $property_count = 0;
	public ?model $owner_model = null;
	public $properties /** hash<storage_property> */ = [];
}
