<?php
declare(strict_types=1);

namespace om3\base\schema;

/** @lib-export */
class storage_property
{
	public ?string $kind = null;
	public ?string $column = null;
	public ?string $sql_type = null;
	public ?bool $is_nullable = null;
	public mixed $default = null;
	public mixed $index = null;
	public ?string $relation_type = null;
	public ?string $relation_table = null;
	public ?string $relation_this_column = null;
	public ?string $relation_target_column = null;
	public ?model_property $owner_property = null;
}
