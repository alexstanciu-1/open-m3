namespace OM3\Tools\Nullable_Mixed_Hash_Assign_Repro;

class Main
{
	public static function run() : void
	{
		$items hash<mixed> = [
			"a" => "ok",
		];
		$value = null;
		if (isset($items["a"])) {
			$value ?mixed = null;
			$value = $items["a"];
			echo "value=", (string)$value, "\n";
		}
	}
}

Main::run();
