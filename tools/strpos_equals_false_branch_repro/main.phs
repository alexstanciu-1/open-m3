namespace OM3\Tools\Strpos_Equals_False_Branch_Repro;

class Main
{
	public static function run_case(string $type_name) : void
	{
		$type_key = strtolower(trim($type_name));
		$paren_pos = strpos($type_key, "(");
		if ($paren_pos === false)
			echo "branch=false\n";
		else
			echo "branch=int\n";
	}

	public static function run() : void
	{
		echo "start\n";
		Main::run_case("string");
		Main::run_case("varchar(32)");
		echo "done\n";
	}
}

Main::run();
