namespace om3\tools\relation_reverse_m2m_repro;

function load_demo_assembler(): \om3\base\assemble\model_assembler
{
	$assembler = new \om3\base\assemble\model_assembler();
	$base_dir = "../../samples/relation_demo";

	$assembler->load_model_file("Property", $base_dir . "/Property.json");
	$assembler->load_model_file("StoreLocation", $base_dir . "/StoreLocation.json");

	$property_model = $assembler->find_raw_model("Property");
	$store_location_model = $assembler->find_raw_model("StoreLocation");
	if ($property_model !== null) {
		$storage = \om3\base\load\json_loader::load_storage($base_dir . "/Property.storage.json");
		if ($storage !== null) {
			\om3\base\load\json_loader::attach_storage($property_model, $storage);
		}
	}
	if ($store_location_model !== null) {
		$storage = \om3\base\load\json_loader::load_storage($base_dir . "/StoreLocation.storage.json");
		if ($storage !== null) {
			\om3\base\load\json_loader::attach_storage($store_location_model, $storage);
		}
	}

	return $assembler;
}

function print_node_mat(string $label, \om3\base\orm\orm_root $root, string $path): void
{
	echo "--node:", $label, "--\n";
	for ($node_index = 0; $node_index < count($root->nodes); $node_index++) {
		$node = $root->nodes[$node_index];
		if ($node->path !== $path) {
			continue;
		}

		echo "path=", ($node->path ?? ""), "\n";
		echo "name=", ($node->name ?? ""), "\n";
		echo "branch_kind=", ($node->branch_kind ?? ""), "\n";
		echo "is_list=", ($node->is_list ? "1" : "0"), "\n";
		for ($mat_index = 0; $mat_index < count($node->mat); $mat_index++) {
			$mat = $node->mat[$mat_index];
			echo "mat:", $mat_index,
				"|mode=", ($mat->mode ?? ""),
				"|table=", ($mat->table ?? ""),
				"|link_table=", ($mat->link_table ?? ""),
				"|owner_column=", ($mat->owner_column ?? ""),
				"|id_column=", ($mat->id_column ?? ""),
				"|value_column=", ($mat->value_column ?? ""),
				"|type_column=", ($mat->type_column ?? "");
			if (count($mat->types) > 0) {
				echo "|types=";
				for ($type_index = 0; $type_index < count($mat->types); $type_index++) {
					if ($type_index > 0) {
						echo ",";
					}
					echo $mat->types[$type_index];
				}
			}
			echo "\n";
		}
		return;
	}

	echo "not_found=", $path, "\n";
}

function print_relation_table(\om3\base\db\db_database $db, string $table_name): void
{
	echo "--relation-table:", $table_name, "--\n";
	if (!isset($db->tables[$table_name])) {
		echo "missing_table\n";
		return;
	}
	$table = $db->tables[$table_name];
	foreach ($table->columns as $column_name => $column) {
		echo "column:", ($column->name ?? ""), ":", ($column->type ?? "");
		if (!$column->is_nullable) {
			echo ":notnull";
		}
		if ($column->auto_increment) {
			echo ":autoincrement";
		}
		echo "\n";
	}
}

function run_case(string $label, string $root_path, string $root_type, string $node_path, string $relation_table): void
{
	$assembler = load_demo_assembler();
	$root = $assembler->build_orm_root($root_path, $root_type);
	echo "==case:", $label, "==\n";
	if ($root === null) {
		echo "root_build_failed\n";
		foreach ($assembler->errors as $error) {
			echo $error, "\n";
		}
		return;
	}

	print_node_mat($label, $root, $node_path);
	$db_builder = new \om3\base\db\structure_builder();
	$db = $db_builder->build_from_orm_root($root);
	if ($db === null) {
		echo "schema_build_failed\n";
		foreach ($db_builder->errors as $error) {
			echo $error, "\n";
		}
		return;
	}
	print_relation_table($db, $relation_table);
	echo "schema_errors=", count($db_builder->errors), "\n";
}

run_case(
	"property_store_locations",
	"Property",
	"Property",
	"Property.StoreLocations",
	"Properties_StoreLocations"
);

run_case(
	"store_location_properties",
	"StoreLocation",
	"StoreLocation",
	"StoreLocation.Properties",
	"Properties_StoreLocations"
);
