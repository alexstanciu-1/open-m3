namespace OM3\Tools\Map_Scalar_Type_Exact_Repro;

class FakeColumn
{
	public ?string $type;
}

class DemoBuilder
{
	public bool $legacy_full_support = true;

	public function map_scalar_type(string $type_name) : string
	{
		$type_key = strtolower(trim($type_name));
		if ($type_key === "")
			return "varchar";

		$paren_pos = strpos($type_key, "(");
		$type_base = ($paren_pos === false) ? $type_key : substr($type_key, 0, $paren_pos);

		if (($type_base === "enum") || ($type_base === "set") || ($type_base === "varchar") || ($type_base === "char") ||
			($type_base === "text") || ($type_base === "datetime") || ($type_base === "date") || ($type_base === "time") ||
			($type_base === "float") || ($type_base === "double") || ($type_base === "decimal") || ($type_base === "numeric") ||
			($type_base === "smallint") || ($type_base === "bigint") || ($type_base === "tinyint"))
			return $type_base;

		if (($type_key == "int") || ($type_key == "integer"))
			return "int";

		if (($type_key == "bool") || ($type_key == "boolean"))
			return $this->legacy_full_support ? "tinyint" : "bool";

		if (($type_key == "float") || ($type_key == "double"))
			return "float";

		if ($type_key == "datetime")
			return "datetime";

		if ($type_key == "date")
			return "date";

		return "varchar";
	}

	public function run_case(string $type_name) : void
	{
		$column = new FakeColumn();
		$column->type = $this->map_scalar_type($type_name);
		echo "type=", (string)$column->type, "\n";
	}
}

class Main
{
	public static function run() : void
	{
		$builder = new DemoBuilder();
		echo "start\n";
		$builder->run_case("string");
		$builder->run_case("varchar(32)");
		echo "done\n";
	}
}

Main::run();
