<?php
declare(strict_types=1);

echo "without_json_decode\n";

$data = (object) ["a" => 1, "b" => 2];
echo "case_1_value_only\n";
foreach ($data as $v) {
	echo $v, "\n";
}

$data = (object) ["a" => 1, "b" => 2];
echo "case_2_key_value\n";
foreach ($data as $k => $v) {
	echo $k, ":", $v, "\n";
}

$data = (object) ["a" => 1, "b" => 2];
echo "case_3_ref_value\n";
foreach ($data as &$v) {
	$v = $v + 10;
}
foreach ($data as $k => $v) {
	echo $k, ":", $v, "\n";
}

$data = (object) ["a" => 1, "b" => 2];
echo "case_4_key_ref_value\n";
foreach ($data as $k => &$v) {
	$v = $v + 10;
	echo $k, ":", $v, "\n";
}
foreach ($data as $k => $v) {
	echo "after:", $k, ":", $v, "\n";
}

echo "with_json_decode\n";

$data = json_decode("{\"a\":1,\"b\":2}");
echo "case_5_value_only\n";
foreach ($data as $v) {
	echo $v, "\n";
}

$data = json_decode("{\"a\":1,\"b\":2}");
echo "case_6_key_value\n";
foreach ($data as $k => $v) {
	echo $k, ":", $v, "\n";
}

$data = json_decode("{\"a\":1,\"b\":2}");
echo "case_7_ref_value\n";
foreach ($data as &$v) {
	$v = $v + 10;
}
foreach ($data as $k => $v) {
	echo $k, ":", $v, "\n";
}

$data = json_decode("{\"a\":1,\"b\":2}");
echo "case_8_key_ref_value\n";
foreach ($data as $k => &$v) {
	$v = $v + 10;
	echo $k, ":", $v, "\n";
}
foreach ($data as $k => $v) {
	echo "after:", $k, ":", $v, "\n";
}
