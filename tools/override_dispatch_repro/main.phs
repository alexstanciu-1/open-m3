namespace om3\tools\override_dispatch_repro;

class base_demo
{
	public function value(): string
	{
		return "base";
	}

	public function call_self(): string
	{
		return $this->value();
	}
}

class child_demo extends base_demo
{
	public function value(): string
	{
		return "child";
	}
}

class main
{
	public static function run(): void
	{
		$item = new child_demo();
		echo "direct=", $item->value(), "\n";
		echo "indirect=", $item->call_self(), "\n";
	}
}

\om3\tools\override_dispatch_repro\main::run();
