namespace om3\tools\explode_perf_repro;

class main
{
	public static function run(): void
	{
		$path = "Omi/Address";
		echo "start\n";
		$started = php::microtime(true);
		for ($i = 0; $i < 100000; $i++) {
			$parts = explode("/", $path);
			if (count($parts) > 0) {
				$last = (string) $parts[count($parts) - 1];
				if ($last === "") {
					echo "never\n";
				}
			}
		}
		$ended = php::microtime(true);
		echo "done:", number_format($ended - $started, 6, ".", ""), "\n";
	}
}

\om3\tools\explode_perf_repro\main::run();
